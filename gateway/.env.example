# Copy to .env next to docker-compose.yml, then: chmod 600 .env
# Never commit .env.

# Any long random string. Generate one with: openssl rand -hex 24
LITELLM_MASTER_KEY=sk-<random>

# Any random string. Used only between LiteLLM and its Postgres.
LITELLM_DB_PASSWORD=<random>

# From the OpenCode Go console (https://opencode.ai/docs/go).
OPENCODE_GO_API_KEY=<your OpenCode Go API key>
